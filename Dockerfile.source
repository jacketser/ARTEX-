# syntax=docker/dockerfile:1
# Build this fork directly, without depending on an upstream ARTEX image.
FROM node:22-bookworm-slim AS frontend
WORKDIR /src/web
ENV NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS=--max-old-space-size=2048
COPY web/package.json web/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY web/ ./
RUN npm run build:static

FROM golang:1.26-bookworm AS backend
WORKDIR /src
ARG GOPROXY=https://proxy.golang.org,direct
ENV CGO_ENABLED=0 GOMAXPROCS=2
ENV GOPROXY=${GOPROXY}
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
COPY --from=frontend /src/web/out/ server/webui/dist/
ARG ARTEX_BUILD_VERSION=dev
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    go build -p 2 -trimpath -tags embedui -ldflags "-s -w -X main.version=${ARTEX_BUILD_VERSION}" -o /out/artex ./cmd/artex

FROM node:22-bookworm-slim AS runtime
ARG DEBIAN_MIRROR=deb.debian.org
RUN sed -i "s|deb.debian.org|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources \
    && apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-pip python3-venv ca-certificates ripgrep curl wget vim git jq unzip \
      dnsutils iputils-ping netcat-openbsd inetutils-telnet whois nmap \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"
RUN npm install -g @playwright/mcp@0.0.83 @playwright/cli@0.1.22 playwright@1.64.1 \
    && playwright-cli --help
RUN sed -i 's|http://|https://|g' /etc/apt/sources.list.d/debian.sources \
    && playwright install-deps chromium \
    && rm -rf /var/lib/apt/lists/* /root/.npm
ARG PLAYWRIGHT_DOWNLOAD_HOST
RUN PLAYWRIGHT_DOWNLOAD_HOST="${PLAYWRIGHT_DOWNLOAD_HOST}" playwright install chromium
WORKDIR /app
COPY --from=backend /out/artex /app/artex
COPY start.sh /app/start.sh
COPY skills/ /app/skills/
COPY scripts/capture-tool-integrity.py /tmp/capture-tool-integrity.py
RUN python3 /tmp/capture-tool-integrity.py /app/tool-integrity.json && rm /tmp/capture-tool-integrity.py
RUN chmod +x /app/artex /app/start.sh
EXPOSE 8787
ENTRYPOINT ["/app/start.sh"]
CMD ["-addr", ":8787", "-proxy", "127.0.0.1:8788"]
